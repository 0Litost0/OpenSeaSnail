{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "allowJs": true,
    "checkJs": false,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "playwright.config.ts",
    "fixtures/**/*.ts",
    "specs/**/*.ts",
    "examples/**/*.ts",
    "checks.config.ts",
    "checks/**/*.ts"
  ]
}
