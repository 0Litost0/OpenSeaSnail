{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:seasnail:api-test:replay:v1",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "case_id": {
      "type": "string",
      "pattern": "^(AUTH|TOKEN|DICT|ASR|CLEAN|RECOVERY|SHERPA|SYSTEM|PROVIDER)-[0-9]{3}$"
    },
    "catalog_version": {
      "type": "string",
      "minLength": 1
    },
    "build": {
      "type": "object",
      "properties": {
        "commit": {
          "type": "string",
          "pattern": "^[a-f0-9]{40}$"
        },
        "dirty": {
          "type": "boolean"
        },
        "binary_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "source_patch": {
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              },
              "required": [
                "id",
                "sha256"
              ],
              "additionalProperties": false
            },
            {
              "type": "null"
            }
          ]
        },
        "toolchain": {
          "type": "string",
          "minLength": 1
        },
        "target": {
          "type": "string",
          "minLength": 1
        },
        "profile": {
          "type": "string",
          "enum": [
            "debug",
            "release"
          ]
        },
        "lock_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "features": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "rustflags": {
          "type": "string"
        }
      },
      "required": [
        "commit",
        "dirty",
        "binary_sha256",
        "source_patch",
        "toolchain",
        "target",
        "profile",
        "lock_sha256",
        "features",
        "rustflags"
      ],
      "additionalProperties": false
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "id",
          "sha256"
        ],
        "additionalProperties": false
      },
      "uniqueItems": true
    },
    "assertion_version": {
      "type": "string",
      "minLength": 1
    },
    "runtime": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "mode": {
              "const": "deterministic"
            },
            "scenario": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "mode",
            "scenario"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "mode": {
              "const": "sherpa"
            },
            "model_id": {
              "type": "string",
              "minLength": 1
            },
            "artifacts": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  }
                },
                "required": [
                  "id",
                  "sha256"
                ],
                "additionalProperties": false
              },
              "minItems": 1
            }
          },
          "required": [
            "mode",
            "model_id",
            "artifacts"
          ],
          "additionalProperties": false
        }
      ]
    },
    "provider": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "mode": {
              "type": "string",
              "enum": [
                "disabled",
                "success",
                "http-503",
                "invalid-json",
                "timeout",
                "interrupted"
              ]
            },
            "scenario_version": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "mode",
            "scenario_version"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "mode": {
              "const": "remote"
            },
            "provider_id": {
              "type": "string",
              "minLength": 1
            },
            "model": {
              "type": "string",
              "minLength": 1
            },
            "endpoint_ref": {
              "type": "string",
              "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._/-]*$"
            },
            "output_deterministic": {
              "const": false
            },
            "scenario_version": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "mode",
            "provider_id",
            "model",
            "endpoint_ref",
            "output_deterministic",
            "scenario_version"
          ],
          "additionalProperties": false
        }
      ]
    },
    "keychain": {
      "type": "object",
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "persistent-fixture",
            "missing-master-dek",
            "read-error-master-dek"
          ]
        }
      },
      "required": [
        "mode"
      ],
      "additionalProperties": false
    },
    "budget_version": {
      "type": "string",
      "minLength": 1
    },
    "fault": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "enum": [
                "MUT-CLEAN-FALLBACK-001",
                "MUT-DICT-PERSIST-001"
              ]
            },
            "patch_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "base_commit": {
              "type": "string",
              "pattern": "^[a-f0-9]{40}$"
            },
            "binary_sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "base_source": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^source-[a-f0-9]{64}$"
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[a-f0-9]{64}$"
                }
              },
              "required": [
                "id",
                "sha256"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "id",
            "patch_sha256",
            "base_commit",
            "binary_sha256"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "credential_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "string",
            "enum": [
              "generated",
              "environment"
            ]
          },
          "reference": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._/-]*$"
          }
        },
        "required": [
          "id",
          "source",
          "reference"
        ],
        "additionalProperties": false
      },
      "uniqueItems": true
    }
  },
  "required": [
    "schema_version",
    "case_id",
    "catalog_version",
    "build",
    "assets",
    "assertion_version",
    "runtime",
    "provider",
    "keychain",
    "budget_version",
    "fault",
    "credential_refs"
  ],
  "additionalProperties": false
}
