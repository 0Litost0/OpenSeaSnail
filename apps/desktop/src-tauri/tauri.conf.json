{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SeaSnail",
  "version": "0.1.0",
  "identifier": "com.seasnail.app",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "SeaSnail",
        "width": 960,
        "height": 680,
        "minWidth": 720,
        "minHeight": 480
      },
      {
        "label": "recording-capsule",
        "title": "SeaSnail 录制中",
        "url": "index.html?capsule=1",
        "width": 144,
        "height": 40,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "visibleOnAllWorkspaces": true,
        "skipTaskbar": true,
        "focus": false,
        "focusable": false,
        "visible": false
      },
      {
        "label": "learning-capsule",
        "title": "SeaSnail Dictionary",
        "url": "index.html?learningCapsule=1",
        "width": 320,
        "height": 88,
        "resizable": false,
        "decorations": false,
        "transparent": false,
        "shadow": true,
        "alwaysOnTop": true,
        "visibleOnAllWorkspaces": true,
        "skipTaskbar": true,
        "focus": false,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "app",
    "icon": ["icons/SeaSnail.icns"],
    "macOS": {
      "minimumSystemVersion": "13.0"
    }
  }
}
